{
  "name": "@kotodayori/zod",
  "version": "2.0.0",
  "description": "Zod schema validation helpers for @kotodayori/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kotodayori/core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "keywords": [
    "webhook",
    "router",
    "typescript",
    "zod",
    "validation",
    "schema"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/kotodayori.git",
    "directory": "packages/zod"
  },
  "homepage": "https://github.com/hideokamoto/kotodayori#readme",
  "bugs": "https://github.com/hideokamoto/kotodayori/issues"
}
