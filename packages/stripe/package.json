{
  "name": "@kotodayori/stripe",
  "version": "2.0.0",
  "description": "Stripe-specific type definitions and utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check-events": "tsx scripts/check-events.ts"
  },
  "dependencies": {
    "@kotodayori/core": "workspace:^"
  },
  "devDependencies": {
    "stripe": "^23.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "stripe": ">=23.0.0"
  },
  "keywords": [
    "stripe",
    "webhook",
    "router",
    "typescript"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/kotodayori.git",
    "directory": "packages/stripe"
  },
  "homepage": "https://github.com/hideokamoto/kotodayori#readme",
  "bugs": "https://github.com/hideokamoto/kotodayori/issues"
}
