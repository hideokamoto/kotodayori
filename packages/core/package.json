{
  "name": "@kotodayori/core",
  "version": "2.0.0",
  "description": "Type-safe webhook routing framework for any event source",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "webhook",
    "router",
    "typescript",
    "event-driven"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/kotodayori.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hideokamoto/kotodayori#readme",
  "bugs": "https://github.com/hideokamoto/kotodayori/issues"
}
