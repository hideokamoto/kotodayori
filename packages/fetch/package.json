{
  "name": "@kotodayori/fetch",
  "version": "0.1.0",
  "description": "Web-standard fetch (Request/Response) adapter for Kotodayori Webhook Router",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kotodayori/core": "workspace:^"
  },
  "devDependencies": {
    "@kotodayori/stripe": "workspace:^",
    "stripe": "^23.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "webhook",
    "router",
    "fetch",
    "cloudflare-workers",
    "bun",
    "deno",
    "nextjs",
    "react-router",
    "typescript"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/kotodayori.git",
    "directory": "packages/fetch"
  },
  "homepage": "https://github.com/hideokamoto/kotodayori#readme",
  "bugs": "https://github.com/hideokamoto/kotodayori/issues"
}
