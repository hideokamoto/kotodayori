{
  "name": "kotodayori-stackblitz-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-config Kotodayori demo for StackBlitz: signed fake Stripe events, no Stripe account required",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@kotodayori/hono": "^1.1.2",
    "@kotodayori/stripe": "^1.2.0",
    "hono": "^4.12.23",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0"
  },
  "stackblitz": {
    "installDependencies": true,
    "startCommand": "npm run dev"
  }
}
