{
  "name": "kotodayori-stackblitz-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-config Kotodayori demo for StackBlitz: signed fake Stripe events, no Stripe account required",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=worker src/server.ts",
    "start": "tsx --conditions=worker src/server.ts",
    "smoke": "tsx --conditions=worker src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@kotodayori/hono": "^2.0.0",
    "@kotodayori/stripe": "^2.0.0",
    "hono": "^4.13.17",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "stackblitz": {
    "installDependencies": true,
    "startCommand": "npm run dev"
  }
}
