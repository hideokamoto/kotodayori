{
  "name": "kotodayori-custom-webhooks-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-config Kotodayori demo for non-Stripe webhooks (CircleCI and LINE) with the generic router",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@kotodayori/core": "^1.2.1",
    "@kotodayori/hono": "^1.1.2",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@line/bot-sdk": "^11.3.0",
    "@types/node": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0"
  },
  "stackblitz": {
    "installDependencies": true,
    "startCommand": "npm run dev"
  }
}
