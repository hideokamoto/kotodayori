{
  "name": "kotodayori",
  "version": "0.0.0",
  "private": true,
  "description": "A Hono-inspired type-safe Stripe Webhook routing library",
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test -- --coverage",
    "test:mutation": "node scripts/run-mutation.mjs",
    "test:mutation:build": "pnpm build && pnpm test:mutation",
    "build": "pnpm -r build",
    "lint": "eslint packages/*/src",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@mizchi/mutator": "^0.5.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.2",
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.5",
      "mermaid>katex": "^0.18.2",
      "tsup>esbuild": "^0.28.2",
      "typedoc>minimatch": "^11.0.5"
    },
    "patchedDependencies": {
      "typedoc@0.28.20": "patches/typedoc@0.28.20.patch"
    }
  }
}
